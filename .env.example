# =========================
# 기본 실행 모드
# =========================
PIPELINE_MODE=production  # mock으로 두면 부트스트랩 smoke test용 더미 결과 생성

# =========================
# 기본 경로
# =========================
WORK_ROOT=./work
OUTPUT_ROOT=./output
LOG_ROOT=./logs
INPUT_ROOT=./input

# =========================
# 실행 / GPU
# =========================
CUDA_VISIBLE_DEVICES=  # resident API는 실행 시점에 프로세스별 CUDA_VISIBLE_DEVICES로 GPU를 나누는 것을 권장한다.
DEVICE=cuda

# =========================
# 모델 지정
# =========================
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
ALIGN_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1  # legacy 호환이 더 중요하면 pyannote/speaker-diarization-3.1

# =========================
# Stage 외부 커맨드 연결
# 값에는 {audio_path}, {input_json}, {output_path}, {output_dir} 플레이스홀더 사용 가능
# =========================
ASR_COMMAND=.venv/bin/python -m src.adapters.qwen_asr --audio "{audio_path}" --output "{output_path}"
ALIGN_COMMAND=.venv/bin/python -m src.adapters.qwen_align --audio "{audio_path}" --input-json "{input_json}" --output "{output_path}"
DIARIZATION_COMMAND=.venv/bin/python -m src.adapters.pyannote_diarize --audio "{audio_path}" --output "{output_path}" --output-dir "{output_dir}"

# =========================
# ASR / Align adapter 세부 설정
# =========================
ASR_DEVICE=cuda
ASR_DTYPE=bfloat16
ASR_DEVICE_MAP=
ASR_ATTN_IMPLEMENTATION=
ASR_CHUNK_MAX_SECONDS=180
ASR_MAX_INFERENCE_BATCH_SIZE=4
ASR_MAX_NEW_TOKENS=512
ASR_FORCE_LANGUAGE=
ASR_CONTEXT=이 오디오는 회의 녹음이다. 발화 내용을 정확히 전사하라.

ALIGN_DEVICE=cuda
ALIGN_DTYPE=bfloat16
ALIGN_DEVICE_MAP=
ALIGN_ATTN_IMPLEMENTATION=
ALIGN_MAX_BATCH_SIZE=8
ALIGN_LANGUAGE=

# =========================
# Hugging Face 캐시 / 토큰
# =========================
HF_HOME=./.hf_cache
HUGGINGFACE_HUB_TOKEN=

# =========================
# SQLite
# =========================
DB_URL=sqlite:///./work/app.sqlite3

# =========================
# 요약(vLLM)
# =========================
# 현재 검증된 서버 예시는 /root/project/vllm/run_120.sh 기준이다.
# 해당 스크립트는 현재 검증 예시에서 GPU 0, 포트 8120, gpt-oss-120b를 사용한다. 서버 운영 정책에 따라 바뀔 수 있다.
# /v1/chat/completions endpoint를 쓰면 client가 chat payload로 자동 전환한다.
SUMMARY_PROVIDER=vllm_generate
SUMMARY_BASE_URL=http://127.0.0.1:8120
SUMMARY_ENDPOINT_PATH=/v1/chat/completions
SUMMARY_API_KEY=
SUMMARY_MODEL=gpt-oss-120b
SUMMARY_TEMPERATURE=0.3
SUMMARY_TOP_P=0.9
SUMMARY_MAX_TOKENS=3000
SUMMARY_RESPONSE_KEY=generated_text

# =========================
# 서비스 간 API 연결
# =========================
# orchestration API가 기능별 API를 HTTP로 호출할 때 사용한다.
TRANSCRIBE_API_BASE_URL=http://127.0.0.1:8091
DIARIZE_API_BASE_URL=http://127.0.0.1:8092
SUMMARIZE_API_BASE_URL=http://127.0.0.1:8093

# =========================
# API 동시성 / 대기열
# =========================
MEETING_JOB_WORKERS=1
TRANSCRIBE_MAX_CONCURRENCY=1
VOICE_MAX_PENDING=3
VOICE_WAIT_TIMEOUT_SEC=15
MEETING_TRANSCRIBE_MAX_PENDING=10
DIARIZE_MAX_CONCURRENCY=1
SUMMARIZE_MAX_CONCURRENCY=1

# =========================
# 파이프라인 튜닝
# =========================
AUDIO_TARGET_SR=16000
AUDIO_TARGET_CHANNELS=1
MERGE_AMBIGUOUS_SEC=0.08
MERGE_AMBIGUOUS_RATIO=0.2
BACKCHANNEL_MODE=keep

# =========================
# Diarization 세부 설정
# =========================
DIARIZATION_DEVICE=cuda
DIARIZATION_NUM_SPEAKERS=
DIARIZATION_MIN_SPEAKERS=
DIARIZATION_MAX_SPEAKERS=
